          "rawSql": "SELECT \r\n    ticket_id AS \"ID\",\r\n    subject AS \"Subject\",\r\n    customer_name AS \"Customer\",\r\n    priority AS \"Priority\",\r\n    status AS \"Status\",\r\n    round(current_age_minutes / 60, 1) AS \"Age (Hours)\"\r\nFROM enriched_tickets_analytics\r\nWHERE status != 'Closed' AND status != 'Resolved'\r\nORDER BY priority DESC, current_age_minutes DESC\r\nLIMIT 10;",
