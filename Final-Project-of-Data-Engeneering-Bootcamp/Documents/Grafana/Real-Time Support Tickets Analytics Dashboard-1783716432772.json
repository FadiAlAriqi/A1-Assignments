          "pluginVersion": "4.19.0",
          "queryType": "table",
          "rawSql": "SELECT \r\n    lower(trim(BOTH '.,!?:;\"()[]{}' FROM arrayJoin(ml_features))) AS clean_word, \r\n    count() AS frequency\r\nFROM default.enriched_tickets_analytics\r\nWHERE length(clean_word) > 3 \r\n  AND clean_word NOT IN ('with', 'this', 'that', 'from', 'your', 'have', 'about', 'there', 'they', 'their') \r\nGROUP BY clean_word\r\nORDER BY frequency DESC\r\nLIMIT 15;",
          "refId": "A"
        }
      ],
      "title": "Most Common Words in Customer Complaints (NLP Analysis)",
      "type": "bargauge"
    },
